/** CNIPMS backend. Google Sheets is the only database. */
const SHEETS = {
  settings: ['Key','Value'],
  genericDrugs: ['id','genericCode','genericName','strength','dosageForm','controlled','status','createdAt','updatedAt'],
  brandProducts: ['id','brandCode','brandName','genericCode','warehouseName','packSize','status','createdAt','updatedAt'],
  stock: ['id','brandCode','location','batchNumber','expiryDate','invoiceNumber','stockUnits','createdAt','updatedAt'],
  reorderLevels: ['id','brandCode','location','value','unit','updatedAt'],
  receipts: ['id','receiptDate','invoiceNumber','brandCode','batchNumber','expiryDate','quantityPacks','quantityUnits','quantityUnitsTotal','receiverName','supplier','duplicateConfirmed','createdAt'],
  vouchers: ['id','voucherNo','voucherDate','destination','brandCode','batchNumber','expiryDate','quantityPacks','quantityUnits','quantityUnitsTotal','controlled','prescriptionCount','createdAt'],
  prescriptions: ['id','voucherId','prescriptionNumber','patientName','packs','units','quantityUnitsTotal','createdAt'],
  movements: ['id','movement','quantityUnits','documentNo','createdAt'],
  cancellations: ['id','documentNo','reason','cancelledAt'],
  adjustments: ['id','location','brandCode','batchNumber','currentUnits','actualUnits','differenceUnits','reason','adjustedAt']
};
const LOCS = ['MAIN','INP','OUT','MC'];

// Simple deployment configuration: no Script Properties required.
// Paste the Google Sheet ID between the quotes below.
const CNIPMS_SPREADSHEET_ID = '1H7tmjs6-oyRKynuFx0QtkzyDHWUhZKjxdfie52bP47o';
// Keep this value identical to API_TOKEN in api/index.js. Keep the GitHub repository PRIVATE.
const CNIPMS_API_TOKEN = 'z2Knr0lpSKqgxzijuzZn2zcfiBjCfMfqwMwCxu9QkU1ENXHy';

function initializeDatabase() {
  if (!CNIPMS_SPREADSHEET_ID || CNIPMS_SPREADSHEET_ID === 'PASTE_YOUR_GOOGLE_SHEETS_ID_HERE') throw new Error('Paste your Google Sheets ID into CNIPMS_SPREADSHEET_ID near the top of Code.gs first.');
  ensureSheets_();
  Logger.log('CNIPMS sheets initialized in spreadsheet: ' + CNIPMS_SPREADSHEET_ID);
}
function doGet() {
  return json_({ok:true,service:'CNIPMS Google Apps Script API',message:'POST actions only. Set CNIPMS_SPREADSHEET_ID in Code.gs before use.'});
}
function doPost(e) {
  if (!CNIPMS_SPREADSHEET_ID || CNIPMS_SPREADSHEET_ID === 'PASTE_YOUR_GOOGLE_SHEETS_ID_HERE') return json_({ok:false,error:'Set CNIPMS_SPREADSHEET_ID near the top of Code.gs.'});
  const lock = LockService.getScriptLock();
  try {
    const body = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    const expected = CNIPMS_API_TOKEN;
    if (!expected || !body.token || !constantTimeEqual_(String(body.token), String(expected))) return json_({ok:false,error:'Unauthorized API request.'});
    if (!CNIPMS_SPREADSHEET_ID) return json_({ok:false,error:'Set CNIPMS_SPREADSHEET_ID near the top of Code.gs.'});
    lock.waitLock(25000);
    ensureSheets_();
    const result = dispatch_(String(body.action || ''), body.payload || {});
    return json_({ok:true,data:result});
  } catch (err) {
    return json_({ok:false,error:err && err.message ? err.message : String(err)});
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}
function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function constantTimeEqual_(a,b){if(a.length!==b.length)return false;let x=0;for(let i=0;i<a.length;i++)x|=a.charCodeAt(i)^b.charCodeAt(i);return x===0;}
function ss_(){if(!CNIPMS_SPREADSHEET_ID || CNIPMS_SPREADSHEET_ID==='PASTE_YOUR_GOOGLE_SHEETS_ID_HERE')throw new Error('Set CNIPMS_SPREADSHEET_ID near the top of Code.gs.');return SpreadsheetApp.openById(CNIPMS_SPREADSHEET_ID);}
function ensureSheets_(){const ss=ss_();Object.keys(SHEETS).forEach(k=>{let sh=ss.getSheetByName(k);if(!sh)sh=ss.insertSheet(k);const headers=SHEETS[k];if(sh.getLastRow()===0)sh.getRange(1,1,1,headers.length).setValues([headers]);else{const actual=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),headers.length)).getValues()[0];if(headers.some((h,i)=>actual[i]!==h))throw new Error('Sheet "'+k+'" has unexpected headers. Do not rename columns; use a clean sheet or restore headers.');}});}
function rows_(key){const sh=ss_().getSheetByName(key);if(!sh||sh.getLastRow()<2)return[];const headers=SHEETS[key];return sh.getRange(2,1,sh.getLastRow()-1,headers.length).getValues().filter(r=>r.some(v=>v!==''&&v!==null)).map(r=>{const o={};headers.forEach((h,i)=>o[h]=cell_(r[i]));return o;});}
function cell_(v){if(v instanceof Date)return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd');return v;}
function append_(key,obj){const sh=ss_().getSheetByName(key);const headers=SHEETS[key];sh.appendRow(headers.map(h=>obj[h]===undefined?'':obj[h]));}
function updateById_(key,id,changes){const sh=ss_().getSheetByName(key);const headers=SHEETS[key];if(sh.getLastRow()<2)throw new Error('Record not found.');const data=sh.getRange(2,1,sh.getLastRow()-1,headers.length).getValues();const idCol=headers.indexOf('id');for(let i=0;i<data.length;i++){if(String(data[i][idCol])===String(id)){headers.forEach((h,j)=>{if(Object.prototype.hasOwnProperty.call(changes,h))data[i][j]=changes[h];});sh.getRange(i+2,1,1,headers.length).setValues([data[i]]);return true;}}throw new Error('Record not found.');}
function deleteById_(key,id){const sh=ss_().getSheetByName(key);const headers=SHEETS[key];if(sh.getLastRow()<2)return false;const idCol=headers.indexOf('id');const vals=sh.getRange(2,1,sh.getLastRow()-1,headers.length).getValues();for(let i=vals.length-1;i>=0;i--){if(String(vals[i][idCol])===String(id)){sh.deleteRow(i+2);return true;}}return false;}
function deleteWhere_(key,field,value){const sh=ss_().getSheetByName(key);const headers=SHEETS[key];if(sh.getLastRow()<2)return;const col=headers.indexOf(field);const vals=sh.getRange(2,1,sh.getLastRow()-1,headers.length).getValues();for(let i=vals.length-1;i>=0;i--)if(String(vals[i][col])===String(value))sh.deleteRow(i+2);}
function id_(){return Utilities.getUuid();}function now_(){return new Date().toISOString();}function str_(v){return String(v===undefined||v===null?'':v).trim();}function num_(v){const n=Number(v);return Number.isFinite(n)?n:0;}function norm_(v){return str_(v).toUpperCase();}
function dispatch_(a,p){switch(a){case'bootstrap':return bootstrap_();case'saveGeneric':return saveGeneric_(p);case'saveBrand':return saveBrand_(p);case'receiveStock':return receiveStock_(p);case'createVoucher':return createVoucher_(p);case'cancelVoucher':return cancelVoucher_(p);case'stockAdjustment':return stockAdjustment_(p);case'setReorderLevel':return setReorderLevel_(p);case'setStatus':return setStatus_(p);case'saveSettings':return saveSettings_(p);default:throw new Error('Unknown action: '+a);}}
function bootstrap_(){const settings={};rows_('settings').forEach(r=>settings[r.Key]=r.Value);return {genericDrugs:rows_('genericDrugs'),brandProducts:rows_('brandProducts'),stock:rows_('stock'),reorderLevels:rows_('reorderLevels'),receipts:rows_('receipts'),vouchers:rows_('vouchers'),prescriptions:rows_('prescriptions'),movements:rows_('movements'),settings:{expiryWarningDays:num_(settings.expiryWarningDays)||90}};}
function uniqueCode_(code,excludeId){const n=norm_(code);if(!n)throw new Error('Code is required.');const g=rows_('genericDrugs'),b=rows_('brandProducts');if(g.some(x=>norm_(x.genericCode)===n&&String(x.id)!==String(excludeId||''))||b.some(x=>norm_(x.brandCode)===n&&String(x.id)!==String(excludeId||'')))throw new Error('This code already exists. Generic and commercial codes must be globally unique (case-insensitive).');}
function saveGeneric_(p){const code=str_(p.genericCode),name=str_(p.genericName),strength=str_(p.strength),form=str_(p.dosageForm),status=str_(p.status||'Active');if(!code||!name||!strength||!form)throw new Error('Complete all required generic-drug fields.');uniqueCode_(code,p.id);const data={genericCode:code,genericName:name,strength:strength,dosageForm:form,controlled:!!p.controlled,status:status,updatedAt:now_()};if(p.id){const old=rows_('genericDrugs').find(x=>String(x.id)===String(p.id));if(!old)throw new Error('Generic drug not found.');updateById_('genericDrugs',p.id,data);if(status==='Inactive')rows_('brandProducts').filter(b=>b.genericCode===old.genericCode).forEach(b=>updateById_('brandProducts',b.id,{status:'Inactive',updatedAt:now_()}));return {id:p.id};}data.id=id_();data.createdAt=now_();append_('genericDrugs',data);return {id:data.id};}
function saveBrand_(p){const code=str_(p.brandCode),name=str_(p.brandName),genericCode=str_(p.genericCode),pack=num_(p.packSize);if(!code||!name||!genericCode||!Number.isInteger(pack)||pack<1)throw new Error('Commercial code, name, generic drug and valid pack size are required.');uniqueCode_(code,p.id);const g=rows_('genericDrugs').find(x=>x.genericCode===genericCode);if(!g)throw new Error('Select an existing generic drug.');if(g.status==='Inactive'&&p.status!=='Inactive')throw new Error('An inactive generic drug cannot have an active commercial product.');const data={brandCode:code,brandName:name,genericCode:genericCode,warehouseName:str_(p.warehouseName),packSize:pack,status:str_(p.status||'Active'),updatedAt:now_()};if(p.id){if(!rows_('brandProducts').some(x=>String(x.id)===String(p.id)))throw new Error('Brand product not found.');updateById_('brandProducts',p.id,data);return{id:p.id};}data.id=id_();data.createdAt=now_();append_('brandProducts',data);return{id:data.id};}
function activeBrand_(code){const b=rows_('brandProducts').find(x=>x.brandCode===str_(code));if(!b)throw new Error('Commercial product not found.');const g=rows_('genericDrugs').find(x=>x.genericCode===b.genericCode);if(b.status!=='Active'||!g||g.status!=='Active')throw new Error('Inactive products cannot be received or distributed.');return {b,g};}
function stockRow_(brand,loc,batch){return rows_('stock').find(s=>s.brandCode===brand&&s.location===loc&&s.batchNumber===batch);}
function upsertStock_(brand,loc,batch,expiry,invoice,delta){let s=stockRow_(brand,loc,batch);if(s){const newQty=num_(s.stockUnits)+delta;if(newQty<0)throw new Error('Insufficient stock in '+loc+' for batch '+batch+'.');updateById_('stock',s.id,{stockUnits:newQty,expiryDate:expiry||s.expiryDate,invoiceNumber:invoice||s.invoiceNumber,updatedAt:now_()});return newQty;}if(delta<0)throw new Error('No stock exists for this batch at '+loc+'.');s={id:id_(),brandCode:brand,location:loc,batchNumber:batch,expiryDate:expiry,invoiceNumber:invoice,stockUnits:delta,createdAt:now_(),updatedAt:now_()};append_('stock',s);return delta;}
function movement_(movement,quantity,doc){append_('movements',{id:id_(),movement:movement,quantityUnits:quantity,documentNo:doc,createdAt:now_()});}
function receiveStock_(p){const {b}=activeBrand_(p.brandCode);const invoice=str_(p.invoiceNumber),batch=str_(p.batchNumber),expiry=str_(p.expiryDate),receiver=str_(p.receiverName),date=str_(p.receiptDate),qty=num_(p.quantity);if(!invoice||!batch||!expiry||!receiver||!date||!Number.isInteger(qty)||qty<1)throw new Error('Complete all required receipt fields with a positive whole quantity.');if(new Date(expiry)<new Date(date))throw new Error('Expiry date cannot be earlier than the receipt date.');const duplicate=rows_('receipts').some(r=>str_(r.invoiceNumber)===invoice&&str_(r.batchNumber)===batch);if(duplicate&&!p.duplicateConfirmed)return {needsDuplicateConfirmation:true};const units=p.quantityUnit==='packs'?qty*num_(b.packSize):qty;const old=stockRow_(b.brandCode,'MAIN',batch);if(old&&old.expiryDate!==expiry)throw new Error('This batch number already exists with a different expiry date. Verify the batch number.');upsertStock_(b.brandCode,'MAIN',batch,expiry,invoice,units);const rec={id:id_(),receiptDate:date,invoiceNumber:invoice,brandCode:b.brandCode,batchNumber:batch,expiryDate:expiry,quantityPacks:p.quantityUnit==='packs'?qty:0,quantityUnits:p.quantityUnit==='units'?qty:0,quantityUnitsTotal:units,receiverName:receiver,supplier:str_(p.supplier),duplicateConfirmed:!!p.duplicateConfirmed,createdAt:now_()};append_('receipts',rec);movement_('Stock Received — Main Warehouse',units,invoice);return {id:rec.id,quantityUnits:units};}
function createVoucher_(p){const {b,g}=activeBrand_(p.brandCode);const no=str_(p.voucherNo),date=str_(p.voucherDate),dest=str_(p.destination),batch=str_(p.batchNumber),packs=num_(p.quantityPacks),units=num_(p.quantityUnits);if(!no||!date||!batch||!['INP','OUT','MC'].includes(dest))throw new Error('Voucher number, date, destination and batch are required.');if(!Number.isInteger(packs)||packs<0||!Number.isInteger(units)||units<0||packs+units<1)throw new Error('Enter a valid positive distribution quantity.');if(rows_('vouchers').some(v=>v.destination===dest&&str_(v.voucherNo)===no))throw new Error('This voucher number already exists for the selected pharmacy. Voucher numbers may repeat across different pharmacies.');const stock=stockRow_(b.brandCode,'MAIN',batch);if(!stock||num_(stock.stockUnits)<packs*num_(b.packSize)+units)throw new Error('Insufficient stock in Main Warehouse for the selected batch. Partial distribution is not allowed.');const total=packs*num_(b.packSize)+units;const rx=Array.isArray(p.prescriptions)?p.prescriptions:[];if(g.controlled){if(!rx.length)throw new Error('Controlled drugs require a prescription register.');let rxTotal=0;rx.forEach(r=>{if(!str_(r.prescriptionNumber)||!str_(r.patientName)||!Number.isInteger(num_(r.packs))||num_(r.packs)<0||!Number.isInteger(num_(r.units))||num_(r.units)<0)throw new Error('Every prescription needs a number, patient name and valid packs/units.');rxTotal+=num_(r.packs)*num_(b.packSize)+num_(r.units);});if(rxTotal!==total)throw new Error('Prescription quantities must equal the total quantity distributed.');}else if(rx.length)throw new Error('Prescription register is not required for non-controlled drugs.');const v={id:id_(),voucherNo:no,voucherDate:date,destination:dest,brandCode:b.brandCode,batchNumber:batch,expiryDate:stock.expiryDate,quantityPacks:packs,quantityUnits:units,quantityUnitsTotal:total,controlled:!!g.controlled,prescriptionCount:rx.length,createdAt:now_()};upsertStock_(b.brandCode,'MAIN',batch,stock.expiryDate,stock.invoiceNumber,-total);upsertStock_(b.brandCode,dest,batch,stock.expiryDate,stock.invoiceNumber,total);append_('vouchers',v);rx.forEach(r=>append_('prescriptions',{id:id_(),voucherId:v.id,prescriptionNumber:str_(r.prescriptionNumber),patientName:str_(r.patientName),packs:num_(r.packs),units:num_(r.units),quantityUnitsTotal:num_(r.packs)*num_(b.packSize)+num_(r.units),createdAt:now_()}));movement_('Distribution Out — Main Warehouse',total,no);movement_('Distribution In — '+dest,total,no);return{id:v.id};}
function cancelVoucher_(p){const v=rows_('vouchers').find(x=>String(x.id)===String(p.id));const reason=str_(p.reason);if(!v)throw new Error('Voucher not found.');if(!reason)throw new Error('Cancellation reason is required.');const destStock=stockRow_(v.brandCode,v.destination,v.batchNumber);if(!destStock||num_(destStock.stockUnits)<num_(v.quantityUnitsTotal))throw new Error('Cannot cancel: the destination pharmacy no longer has enough stock from this batch. Resolve the stock discrepancy before cancellation.');upsertStock_(v.brandCode,v.destination,v.batchNumber,v.expiryDate,'',-num_(v.quantityUnitsTotal));upsertStock_(v.brandCode,'MAIN',v.batchNumber,v.expiryDate,'',num_(v.quantityUnitsTotal));append_('cancellations',{id:id_(),documentNo:v.voucherNo,reason:reason,cancelledAt:now_()});movement_('Distribution Cancellation — Reverse Transfer',num_(v.quantityUnitsTotal),v.voucherNo);deleteWhere_('prescriptions','voucherId',v.id);deleteById_('vouchers',v.id);return{cancelled:true};}
function stockAdjustment_(p){const loc=str_(p.location),batch=str_(p.batchNumber),code=str_(p.brandCode),reason=str_(p.reason),packs=num_(p.actualPacks),units=num_(p.actualUnits);const b=rows_('brandProducts').find(x=>x.brandCode===code);if(!b||!LOCS.includes(loc)||!batch||!reason)throw new Error('Product, location, batch and reason are required.');if(!Number.isInteger(packs)||packs<0||!Number.isInteger(units)||units<0||units>=num_(b.packSize))throw new Error('Packs and units must be non-negative integers, and remaining units must be less than Pack Size.');const current=stockRow_(code,loc,batch);if(!current)throw new Error('No stock record exists for this batch and location.');const actual=packs*num_(b.packSize)+units,diff=actual-num_(current.stockUnits);updateById_('stock',current.id,{stockUnits:actual,updatedAt:now_()});movement_(diff>=0?'Stock Adjustment — Increase':'Stock Adjustment — Decrease',Math.abs(diff),code+' / '+batch);append_('adjustments',{id:id_(),location:loc,brandCode:code,batchNumber:batch,currentUnits:num_(current.stockUnits),actualUnits:actual,differenceUnits:diff,reason:reason,adjustedAt:now_()});return{currentUnits:num_(current.stockUnits),actualUnits:actual,difference:diff};}
function setReorderLevel_(p){const code=str_(p.brandCode),loc=str_(p.location),value=num_(p.value),unit=str_(p.unit);if(!rows_('brandProducts').some(b=>b.brandCode===code)||!LOCS.includes(loc)||!Number.isInteger(value)||value<0||!['packs','units'].includes(unit))throw new Error('Enter a valid product, location, reorder value and unit.');const existing=rows_('reorderLevels').find(r=>r.brandCode===code&&r.location===loc);if(existing)updateById_('reorderLevels',existing.id,{value:value,unit:unit,updatedAt:now_()});else append_('reorderLevels',{id:id_(),brandCode:code,location:loc,value:value,unit:unit,updatedAt:now_()});return{saved:true};}
function setStatus_(p){const status=str_(p.status);if(!['Active','Inactive'].includes(status))throw new Error('Invalid status.');if(p.type==='generic'){const g=rows_('genericDrugs').find(x=>String(x.id)===String(p.id));if(!g)throw new Error('Generic drug not found.');updateById_('genericDrugs',g.id,{status:status,updatedAt:now_()});if(status==='Inactive')rows_('brandProducts').filter(b=>b.genericCode===g.genericCode).forEach(b=>updateById_('brandProducts',b.id,{status:'Inactive',updatedAt:now_()}));}else if(p.type==='brand'){const b=rows_('brandProducts').find(x=>String(x.id)===String(p.id));if(!b)throw new Error('Brand product not found.');const g=rows_('genericDrugs').find(x=>x.genericCode===b.genericCode);if(status==='Active'&&g&&g.status==='Inactive')throw new Error('The linked generic drug is inactive. Activate it first.');updateById_('brandProducts',b.id,{status:status,updatedAt:now_()});}else throw new Error('Unknown record type.');return{saved:true};}
function saveSettings_(p){const n=num_(p.expiryWarningDays);if(!Number.isInteger(n)||n<1||n>3650)throw new Error('Expiry warning must be a whole number between 1 and 3650 days.');const sh=ss_().getSheetByName('settings');const all=rows_('settings');const found=all.find(x=>x.Key==='expiryWarningDays');if(found){const data=sh.getRange(2,1,sh.getLastRow()-1,2).getValues();for(let i=0;i<data.length;i++)if(String(data[i][0])==='expiryWarningDays'){sh.getRange(i+2,2).setValue(n);return{saved:true};}}append_('settings',{Key:'expiryWarningDays',Value:n});return{saved:true};}
